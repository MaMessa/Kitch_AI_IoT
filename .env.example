# Set a descriptive app name and contact address before making Open Food Facts requests.
OPENFOODFACTS_USER_AGENT=KitchAI/0.1 (contact@example.com)
# List the browser origins allowed to call the API, separated by commas.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set this to true only when the frontend and API are served over HTTPS.
COOKIE_SECURE=false
# Select Mailpit to capture emails locally, or Resend for real delivery.
APP_ENV=development
EMAIL_BACKEND=mailpit
# Use a fake development sender in the local inbox.
EMAIL_FROM_ADDRESS=KitchAI <no-reply@kitchai.local>
# Connect the API to Mailpit's local SMTP port.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# Store your Resend sending-only API key here, never in source control.
RESEND_API_KEY=
# Use an address on a domain verified in Resend before sending to real users.
RESEND_FROM_EMAIL=KitchAI <no-reply@your-verified-domain.example>
# Set the public base address used by links inside verification and reset emails.
FRONTEND_BASE_URL=http://localhost:5173

# Local demo account settings. Keep real passwords only in the ignored .env file.
ADMIN_EMAIL=maxime.messaoui@gmail.com
ADMIN_INITIAL_PASSWORD=
DEMO_USER_EMAIL=kitchai.demo@example.com
DEMO_USER_PASSWORD=
